#version 450
// GPU path self-test: dst[i] = src[i] * 2654435761 + i (proves the shader ran).

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };

layout(push_constant) uniform PC { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) dst[i] = src[i] * 2654435761u + i;
}
